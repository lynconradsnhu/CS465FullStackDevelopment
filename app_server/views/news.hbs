<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
	<meta charset="UTF-8">
	<title>News - Travlr Getaways Website Template</title>
	<link rel="stylesheet" href="stylesheets/style.css" type="text/css">
</head>
<body>
	<div id="background">
		<div id="page">
			{{>header}}
			<div id="contents">
				<div class="box">
					<div>
						<div id="news" class="body">
							<div class="sidebar">
								<h3>Latest News</h3>
								<ul>
									{{#each news}}
									<li>
										<a href="/news">{{title}}</a>
									</li>
									{{/each}}
								</ul>
								<h3>Vacation Tips</h3>
								<ul>
									<li>
										<a href="/news">What to bring on the beach?</a>
									</li>
									<li>
										<a href="/news">Planning Fun Activities</a>
									</li>
									<li>
										<a href="/news">Diving Checklist</a>
									</li>
									<li>
										<a href="/news">First Aid</a>
									</li>
									<li>
										<a href="/news">How to Build a Sand Castle?</a>
									</li>
									<li>
										<a href="/news">Tanning Tips</a>
									</li>
								</ul>
							</div>
							<div>
								<h1>News</h1>
								{{#each news}}
								<img src="{{image}}" alt="Img">
								<h2>{{title}}</h2>
								<span class="time">{{date}}<br> by: {{author}}</span>
								<p>
									{{description}}
								</p>
								{{/each}}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		{{>footer}}
	</div>
</body>
</html>